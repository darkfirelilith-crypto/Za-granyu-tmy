// Prisma schema for the world beyond the darkness ("За гранью тьмы")
// Deployed to Vercel with PostgreSQL (Neon). Local dev can use either.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Auth & Users =====

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      String    @default("PLAYER") // ADMIN (Божество) | PLAYER (Приключенец)
  character Character?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ===== Characters & Achievements =====

model Character {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  race        String?
  charClass   String?
  alignment   String?  // мировоззрение (Lawful Good, Chaotic Neutral, etc.)
  level       Int      @default(1)
  xp          Int      @default(0)
  bio         String?  // предыстория / backstory
  traits      String?  // черты характера
  ideals      String?  // идеалы
  motives     String?  // мотивы
  portrait    String?  // base64 image
  guildRankId String?
  guildRank   GuildRank? @relation(fields: [guildRankId], references: [id])
  achievements CharacterAchievement[]
  questProgress QuestProgress[]
  notes       Note[]
  groupMemberships GroupMember[]
  relationsOwned   CharacterRelation[] @relation("RelationOwner")
  relationsAsTarget CharacterRelation[] @relation("RelationTarget")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Personal journal notes owned by a character
model Note {
  id          String   @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  title       String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Achievement {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String?  // emoji or lucide icon name
  rarity      String   @default("COMMON") // COMMON | RARE | EPIC | LEGENDARY | MYTHIC
  category    String?  // e.g. "Боевые", "Исследования", "Социальные"
  autoGrant   Boolean  @default(false)
  // Auto-grant condition: conditionType in {QUEST_COMPLETED, XP_THRESHOLD, RANK_REACHED, QUEST_COUNT, MANUAL}
  conditionType  String?
  conditionValue String?
  characters  CharacterAchievement[]
  createdAt   DateTime @default(now())
}

model CharacterAchievement {
  characterId   String
  achievementId String
  grantedAt     DateTime @default(now())
  grantedBy     String?  // admin userId or "auto"
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([characterId, achievementId])
}

// ===== Knowledge Base (База Знаний) =====

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  banner      String?  // image url
  emblem      String?  // emoji or symbol
  capital     String?
  government  String?
  population  String?
  culture     String?
  climate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Personality {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String?
  description String
  portrait    String?
  race        String?
  age         String?
  gender      String?
  appearance  String?
  affiliation String?
  role        String?
  status      String   @default("alive")
  isNpc       Boolean  @default(false) // true = this is an NPC, can be assigned to groups
  visibleGroupId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  groupNpcs       GroupNpc[]
  characterRelations CharacterRelation[]
}

// ===== Important Beings (Важные Существа) — key NPCs of the campaign =====

model ImportantBeing {
  id                  String   @id @default(cuid())
  name                String   @unique
  title               String?
  race                String?
  age                 String?
  gender              String?
  appearance          String?  // описание внешности
  loreDescription     String?  // лор персонажа
  characterDescription String? // описание характера
  status              String   @default("alive") // alive | deceased | missing
  whereToMeet         String?  // где можно встретить
  notes               String?  // заметка о персонаже
  portrait            String?  // base64 image
  // Optional link to Personality (если это та же личность)
  personalityId       String?
  // Visibility: null = visible to everyone; otherwise only members of this group
  visibleGroupId      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model CountryRelation {
  id           String  @id @default(cuid())
  countryAName String
  countryBName String
  relationType String  // ally | enemy | neutral | trade | vassal
  description  String?
  createdAt    DateTime @default(now())
}

model WorldSystem {
  id          String   @id @default(cuid())
  title       String   @unique
  category    String   // POLITICS | ECONOMY | MILITARY | MAGIC | RELIGION | LAW
  description String
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model God {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String?
  domain      String   // war, love, death, knowledge, etc.
  description String
  symbol      String?  // emoji
  alignment   String?  // good | neutral | evil
  pantheon    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Legend {
  id          String   @id @default(cuid())
  title       String   @unique
  content     String
  era         String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Adventurer's Guild (Гильдия Авантюристов) =====

model GuildRank {
  id          String   @id @default(cuid())
  name        String
  level       Int      @unique
  description String?
  icon        String?  // emoji
  minXp       Int      @default(0)
  members     Character[]
  createdAt   DateTime @default(now())
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String
  difficulty  String   @default("MEDIUM") // TRIVIAL | EASY | MEDIUM | HARD | DEADLY
  reward      String?
  location    String?
  status      String   @default("OPEN") // OPEN | ASSIGNED | COMPLETED | FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    QuestProgress[]
}

model QuestProgress {
  questId     String
  characterId String
  status      String   @default("ASSIGNED") // ASSIGNED | COMPLETED | FAILED
  acceptedAt  DateTime @default(now())
  completedAt DateTime?
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([questId, characterId])
}

// ===== Grimoire (Гримуар) — encrypted lore, chapters with hidden titles =====

model GrimoireEntry {
  id             String   @id @default(cuid())
  title          String   @unique          // real chapter title (hidden when sealed)
  encodedTitle   String?                   // cipher-like title shown when sealed
  encodedContent String   @default("")     // cipher-like text shown when sealed
  realContent    String   @default("")     // actual lore shown when unsealed (main body)
  unlocked       Boolean  @default(false)
  autoUnlocked   Boolean  @default(false)  // true if unsealed by condition (vs manual)
  unlockHint     String?
  category       String   @default("SECRETS") // SECRETS | RITUALS | PROPHECY | HISTORY | BEASTIARY
  order          Int      @default(0)
  loreDate       String?  // дата написания главы (по лору)
  // Entry type: DIARY (дневник) | SPELL_FORMULA (магическая формула) | NOTE (заметка)
  entryType      String   @default("NOTE")
  // Paper decoration style: PLAIN | BLOOD | BURNED | TEARS | INK | FROST | GOLD
  paperStyle     String   @default("PLAIN")
  // Common: margin notes (top + bottom)
  marginTop      String?
  marginBottom   String?
  // DIARY: large body (realContent) + postscript
  postscript     String?
  // SPELL_FORMULA: author reflection + formula + spell notes
  spellReflection String?
  spellFormula    String?
  spellNotes      String?
  // Auto-unlock condition
  conditionType  String?
  conditionValue String?
  // Visibility: null = visible to everyone; otherwise only visible to members of this group
  visibleGroupId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ===== Crimson Laboratory (Лаборатория Алого) — custom homebrew mechanics =====

model LabEntry {
  id          String   @id @default(cuid())
  kind        String   // RACE | CLASS | SUBCLASS | SPELL | ITEM
  name        String   @unique
  subtitle    String?  // e.g. "Подкласс Паладина", "Заклинание 3 круга"
  description String   // main text
  details     String?  // structured extra info (traits, stats, components, etc.)
  icon        String?  // emoji
  image       String?  // base64 image (illustration / symbol)
  rarity      String?  // for items/spells: COMMON..MYTHIC or spell level
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== Editable Site Content (история гильдии, девиз, залы, описание зала) =====

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique // guild_history | guild_motto | guild_halls | hall_intro | hall_world | hall_features
  title     String?
  body      String?
  image     String?  // base64 image (optional)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ===== Groups (кампания — объединение игроков + встреченные НПС) =====

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  image       String?  // base64 (герб / эмблема группы)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     GroupMember[]
  npcs        GroupNpc[]
}

model GroupMember {
  id          String   @id @default(cuid())
  groupId     String
  characterId String
  role        String?  // напр. "Лидер", "Член", "Гость"
  joinedAt    DateTime @default(now())
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([groupId, characterId])
}

model GroupNpc {
  id             String   @id @default(cuid())
  groupId        String
  personalityId String
  role           String?  // напр. "Союзник", "Контакт", "Враг", "Наставник"
  notes          String?
  addedAt        DateTime @default(now())
  group          Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  personality    Personality @relation(fields: [personalityId], references: [id], onDelete: Cascade)

  @@unique([groupId, personalityId])
}

// ===== Character relations (отношения персонажа с НПС и другими персонажами) =====

model CharacterRelation {
  id                  String   @id @default(cuid())
  ownerId             String   // character who has the feeling
  targetCharacterId   String?  // another player's character (nullable)
  targetPersonalityId String?  // an NPC (nullable)
  relationLabel       String   // напр. "Друг", "Враг", "Союзник", "Родственник", "Любим", "Ненависть", "Знакомый"
  description         String?  // свободное описание отношения
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  owner               Character   @relation("RelationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetCharacter     Character?  @relation("RelationTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)
  targetPersonality   Personality? @relation(fields: [targetPersonalityId], references: [id], onDelete: Cascade)

  // exactly one of targetCharacterId/targetPersonalityId should be set (enforced in app)
}

