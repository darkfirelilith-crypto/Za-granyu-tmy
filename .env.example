# ===== Environment variables for «За гранью тьмы» =====
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database ---
# Local development (SQLite): use a file URL with the local schema.
#   Run `bun run dev` (auto-detects SQLite via DATABASE_URL starting with "file:")
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production (Neon Postgres): use the pooled connection string from your Neon dashboard.
#   On Vercel, set this in Environment Variables. Use the pooler URL for serverless.
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret"
# After first Vercel deploy, set this to your exact Vercel URL (https://...)
NEXTAUTH_URL="http://localhost:3000"

# --- Admin seed (optional, used by `bun run seed:prod`) ---
ADMIN_EMAIL="deity@eldrin.world"
ADMIN_PASSWORD="change-this-password-after-first-login"
ADMIN_NAME="Аэтериус"
